{
  "manifest_version": 3,
  "name": "FASIH 3603 Helper",
  "version": "1.0.0",
  "description": "Suite Otomasi Pembersihan Data & KBLI Survei BPS Kabupaten Tangerang",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Buka FASIH 3603 Helper (Side Panel)",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://fasih-sm.bps.go.id/*",
    "https://sso.bps.go.id/*",
    "https://*.bps.go.id/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fasih-sm.bps.go.id/*",
        "https://sso.bps.go.id/*",
        "https://*.bps.go.id/*"
      ],
      "js": [
        "content/fh_namespace.js",
        "content/dom_toolkit.js",
        "content/session_guard.js",
        "content/tasks/remark_kbli.task.js",
        "content/tasks/kbli_sembako.task.js",
        "content/tasks/kbli_pmm.task.js",
        "content/tasks/cleaning_usaha.task.js",
        "content/tasks/cleaning_nik_r30.task.js",
        "content/tasks/cleaning_nik_r27.task.js",
        "content/content_main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
